    "./switch": {
      "types": "./dist/switch.d.ts",
      "fig-development": "./dist-development/switch.js",
      "import": "./dist/switch.js",
      "default": "./dist/switch.js"
    },
    "./tabs": {
      "types": "./dist/tabs.d.ts",
      "fig-development": "./dist-development/tabs.js",
      "import": "./dist/tabs.js",
      "default": "./dist/tabs.js"
    },
    "./tabs/indicator": {
      "types": "./dist/tabs/indicator.d.ts",
      "fig-development": "./dist-development/tabs/indicator.js",
      "import": "./dist/tabs/indicator.js",
      "default": "./dist/tabs/indicator.js"
    },
    "./toast": {
      "types": "./dist/toast.d.ts",
      "fig-development": "./dist-development/toast.js",
      "import": "./dist/toast.js",
      "default": "./dist/toast.js"
    },
    "./toolbar": {
      "types": "./dist/toolbar.d.ts",
      "fig-development": "./dist-development/toolbar.js",
      "import": "./dist/toolbar.js",
      "default": "./dist/toolbar.js"
