{
  "name": "@bgub/fig-ui",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Accessible headless widgets for Fig",
  "keywords": [
    "fig",
    "headless",
    "accessibility",
    "ui"
  ],
  "homepage": "https://github.com/bgub/fig",
  "type": "module",
  "exports": {
    "./accordion": {
      "types": "./dist/accordion.d.ts",
      "fig-development": "./dist-development/accordion.js",
      "import": "./dist/accordion.js",
      "default": "./dist/accordion.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox.d.ts",
      "fig-development": "./dist-development/checkbox.js",
      "import": "./dist/checkbox.js",
      "default": "./dist/checkbox.js"
    },
    "./combobox": {
      "types": "./dist/combobox.d.ts",
      "fig-development": "./dist-development/combobox.js",
      "import": "./dist/combobox.js",
      "default": "./dist/combobox.js"
    },
    "./dialog": {
      "types": "./dist/dialog.d.ts",
      "fig-development": "./dist-development/dialog.js",
      "import": "./dist/dialog.js",
      "default": "./dist/dialog.js"
    },
    "./field": {
      "types": "./dist/field.d.ts",
      "fig-development": "./dist-development/field.js",
      "import": "./dist/field.js",
      "default": "./dist/field.js"
    },
    "./listbox": {
      "types": "./dist/listbox.d.ts",
      "fig-development": "./dist-development/listbox.js",
      "import": "./dist/listbox.js",
      "default": "./dist/listbox.js"
    },
    "./menu": {
      "types": "./dist/menu.d.ts",
      "fig-development": "./dist-development/menu.js",
      "import": "./dist/menu.js",
      "default": "./dist/menu.js"
    },
    "./menu/submenu": {
      "types": "./dist/menu/submenu.d.ts",
      "fig-development": "./dist-development/menu/submenu.js",
      "import": "./dist/menu/submenu.js",
      "default": "./dist/menu/submenu.js"
    },
    "./popover": {
      "types": "./dist/popover.d.ts",
      "fig-development": "./dist-development/popover.js",
      "import": "./dist/popover.js",
      "default": "./dist/popover.js"
    },
    "./radio-group": {
      "types": "./dist/radio-group.d.ts",
      "fig-development": "./dist-development/radio-group.js",
      "import": "./dist/radio-group.js",
      "default": "./dist/radio-group.js"
    },
    "./select": {
      "types": "./dist/select.d.ts",
      "fig-development": "./dist-development/select.js",
      "import": "./dist/select.js",
      "default": "./dist/select.js"
