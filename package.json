{
  "name": "fig",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "turbo run build --filter=@bgub/fig-server... --filter=@bgub/fig-reconciler... && node benchmarks/reconciler.mjs",
    "build": "turbo run build",
    "build:e2e": "FIG_DEV_SOURCE=1 turbo run build --filter=@bgub/fig-demo-ssr... --filter=@bgub/fig-demo-client... --filter=@bgub/fig-demo-payload... --filter=@bgub/fig-demo-tanstack-start...",
    "check": "turbo run quality",
    "dev": "FIG_DEV_SOURCE=1 turbo run dev --filter='./apps/*' --ui=tui --concurrency=14",
    "fix": "turbo run quality:fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt .",
    "generate:jsx-attributes": "node scripts/generate-jsx-attributes.mjs",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "turbo run test test:bench test:release",
    "test:bench": "node --test benchmarks/*.test.mjs",
    "test:release": "node --test scripts/release/*.test.mts",
    "test:dom": "turbo run test --filter=@bgub/fig-dom",
    "test:e2e": "pnpm test:hmr && pnpm build:e2e && FIG_E2E_PREBUILT=1 turbo run test:e2e --concurrency=4 --filter=@bgub/fig-demo-ssr --filter=@bgub/fig-demo-client --filter=@bgub/fig-demo-payload --filter=@bgub/fig-demo-tanstack-start",
    "test:hmr": "FIG_DEV_SOURCE= turbo run build --filter=@bgub/fig-demo-tanstack-start... && pnpm --filter @bgub/fig-demo-tanstack-start probe:hmr",
    "test:reconciler": "turbo run test --filter=@bgub/fig-reconciler",
    "test:watch": "vitest",
    "tegami": "node scripts/tegami.mts",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "path": "packages/fig/dist/index.js",
      "limit": "5.1 kB"
    },
    {
      "name": "fig core without data",
      "path": "packages/fig/dist/index.js",
      "import": "{ createElement, useState, useReactive, readPromise, Suspense }",
      "limit": "1.1 kB"
    },
    {
      "path": "packages/fig-dom/dist/index.js",
      "limit": "34.2 kB"
    },
    {
      "path": "packages/fig-ui/dist/accordion.js",
      "ignore": [
        "@bgub/fig",
        "@bgub/fig-dom"
      ],
      "limit": "2.6 kB"
    },
    {
      "path": "packages/fig-ui/dist/checkbox.js",
      "ignore": [
        "@bgub/fig",
        "@bgub/fig-dom"
      ],
      "limit": "1.6 kB"
    },
    {
      "path": "packages/fig-ui/dist/combobox.js",
      "ignore": [
        "@bgub/fig",
        "@bgub/fig-dom"
      ],
      "limit": "4.4 kB"
    },
    {
      "path": "packages/fig-ui/dist/field.js",
      "ignore": [
        "@bgub/fig",
        "@bgub/fig-dom"
      ],
      "limit": "1.2 kB"
    },
    {
      "path": "packages/fig-ui/dist/listbox.js",
      "ignore": [
        "@bgub/fig",
        "@bgub/fig-dom"
      ],
      "limit": "3.3 kB"
    },
    {
      "path": "packages/fig-ui/dist/switch.js",
      "ignore": [
        "@bgub/fig",
        "@bgub/fig-dom"
      ],
      "limit": "1.6 kB"
    },
    {
      "path": "packages/fig-ui/dist/dialog.js",
      "ignore": [
        "@bgub/fig",
        "@bgub/fig-dom"
      ],
      "limit": "2.2 kB"
    },
    {
      "path": "packages/fig-ui/dist/menu.js",
      "ignore": [
        "@bgub/fig",
        "@bgub/fig-dom"
      ],
      "limit": "3.5 kB"
    },
    {
      "path": "packages/fig-ui/dist/menu/submenu.js",
      "ignore": [
        "@bgub/fig",
        "@bgub/fig-dom"
      ],
      "limit": "4 kB"
    },
    {
      "path": "packages/fig-ui/dist/popover.js",
      "ignore": [
        "@bgub/fig",
        "@bgub/fig-dom"
      ],
      "limit": "1.8 kB"
    },
    {
      "path": "packages/fig-ui/dist/radio-group.js",
      "ignore": [
        "@bgub/fig",
        "@bgub/fig-dom"
      ],
      "limit": "2.5 kB"
    },
    {
      "path": "packages/fig-ui/dist/select.js",
      "ignore": [
        "@bgub/fig",
        "@bgub/fig-dom"
      ],
      "limit": "4.5 kB"
    },
    {
      "path": "packages/fig-ui/dist/tabs.js",
      "ignore": [
        "@bgub/fig",
        "@bgub/fig-dom"
      ],
      "limit": "3.3 kB"
    },
    {
      "path": "packages/fig-ui/dist/tabs/indicator.js",
      "ignore": [
        "@bgub/fig",
        "@bgub/fig-dom"
      ],
      "limit": "1.2 kB"
    },
    {
      "path": "packages/fig-ui/dist/toast.js",
      "ignore": [
        "@bgub/fig",
        "@bgub/fig-dom"
      ],
      "limit": "1.8 kB"
    },
    {
      "path": "packages/fig-ui/dist/toolbar.js",
      "ignore": [
        "@bgub/fig",
        "@bgub/fig-dom"
      ],
      "limit": "2.1 kB"
    },
    {
      "path": "packages/fig-ui/dist/tooltip.js",
      "ignore": [
        "@bgub/fig",
        "@bgub/fig-dom"
      ],
      "limit": "1.8 kB"
    },
    {
      "name": "Fig DOM createRoot without View Transitions",
      "path": "scripts/size-fixtures/fig-dom-base.mjs",
      "limit": "26.5 kB"
    },
    {
      "name": "Fig DOM createRoot with View Transitions",
      "path": "scripts/size-fixtures/fig-dom-view-transitions.mjs",
      "limit": "29.8 kB"
    },
    {
      "name": "Fig DOM all exports with View Transitions",
      "path": "scripts/size-fixtures/fig-dom-all-view-transitions.mjs",
      "limit": "37.5 kB"
    },
    {
      "path": "packages/fig-reconciler/dist/index.js",
      "limit": "17.6 kB"
    },
    {
      "name": "Fig TanStack Router Start surface",
      "path": "packages/fig-tanstack-router/dist/router.js",
      "import": "{ createFileRoute, createRootRouteWithContext, createRouter, RouterProvider, Link, Outlet, HeadContent, Scripts, ensureRouteData }",
      "ignore": [
        "@bgub/fig",
        "@bgub/fig-dom"
      ],
      "limit": "25 kB"
    }
  ],
  "devDependencies": {
    "@bgub/fig": "workspace:*",
    "@bgub/fig-devtools": "workspace:*",
    "@bgub/fig-dom": "workspace:*",
    "@bgub/fig-server": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@tsdown/css": "0.22.14",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "happy-dom": "^20.11.2",
    "html-element-attributes": "3.5.0",
    "jsr": "0.14.3",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "portless": "^0.15.5",
    "postcss": "^8.5.26",
    "postcss-import": "^16.1.1",
    "react": "19.2.8",
    "react-reconciler": "0.33.0",
    "size-limit": "^13.0.3",
    "svg-element-attributes": "2.2.0",
    "tegami": "1.3.5",
    "tsdown": "0.22.14",
    "turbo": "2.10.9",
    "typescript": "^7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.13.1"
}
